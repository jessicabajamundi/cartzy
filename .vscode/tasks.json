{
  "version": "2.0.0",
  "tasks": [
    {
      // Lets a USB phone reach the local Laravel API at 127.0.0.1:8000.
      // The forward is lost whenever the phone reconnects, so it runs before every launch.
      "label": "adb reverse 8000",
      "type": "shell",
      "command": "adb reverse tcp:8000 tcp:8000",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    }
  ]
}