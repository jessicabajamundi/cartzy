{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cartzy Android (local API)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=API_BASE_URL_APP=http://127.0.0.1:8000/api"
      ],
      "preLaunchTask": "adb reverse 8000"
    },
    {
      "name": "Cartzy Web (local API)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define=API_BASE_URL_WEB=http://127.0.0.1:8000/api"
      ]
    }
  ]
}
